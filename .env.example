# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.mariobarman.com.br

# Envio do formulário de orçamento:
#   whatsapp (padrão) → abre o WhatsApp com a mensagem pronta
#   api              → envia JSON (POST) para NEXT_PUBLIC_QUOTE_ENDPOINT
NEXT_PUBLIC_QUOTE_PROVIDER=whatsapp
NEXT_PUBLIC_QUOTE_ENDPOINT=
